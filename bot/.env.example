# ====================================================================
# 15minYoga Telegram agent — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ====================================================================

# --- Telegram ---
BOT_TOKEN=123456:REPLACE_WITH_TOKEN_FROM_@BotFather
# Telegram numeric id(s) of the author/admin(s), comma-separated.
# Find yours by writing to @userinfobot.
ADMIN_IDS=000000000
# Private members channel id (e.g. -1001234567890). Bot must be admin there.
MEMBERS_CHANNEL_ID=

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Cheap+fast model for support/FAQ; nuanced model for sales/escalation.
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_SMART=claude-sonnet-4-6

# --- Class links (sent only to active members at class time) ---
STREAM_LINK=https://zoom.us/j/REPLACE_ME
STREAM_LINK_WEEKLY=https://zoom.us/j/REPLACE_ME_WEEKLY

# --- Manual payment details (delivered by the bot on request) ---
# Счета клиентам выставляет немецкое ЧП (Olha Filianova) — см. legal.operator в project.config.json.
EUR_IBAN=DE00 0000 0000 0000 0000 00
EUR_BENEFICIARY=Your Name
EUR_BIC=XXXXDEXXXXX
EUR_BANK=Your Bank
# Украина: LiqPay (ФОП Фільянов П.О.)
LIQPAY_LINK=https://www.liqpay.ua/api/3/checkout/REPLACE_ME
# Криптовалюта: рекомендуется USDT TRC-20
CRYPTO_NETWORK=USDT-TRC20
CRYPTO_WALLET=REPLACE_ME
PAYPAL_ME=https://www.paypal.me/REPLACE_ME

# --- Automated checkout links (optional, fill when enabled) ---
PAY_LINK_M1=
PAY_LINK_M6=
PAY_LINK_M12=

# --- Database ---
# SQLite for MVP (file path). For production switch to Postgres DSN.
DATABASE_PATH=niguma.db

# --- Email / ESP (optional, secondary channel) ---
RESEND_API_KEY=
EMAIL_FROM=15minyoga.com@gmail.com

# --- Behaviour ---
TIMEZONE=Europe/Vienna
DEFAULT_LOCALE=ru
# Confidence (0..1) below which the AI escalates to the author instead of answering.
AI_ESCALATE_THRESHOLD=0.55
