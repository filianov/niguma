{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "//": "Картинки и шрифты неизменны: меняется содержимое — меняем имя файла.",
      "source": "/(.*)\\.(svg|jpg|jpeg|png|webp|ico|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "//": "CSS и JS лежат по постоянным адресам, поэтому кешировать их навсегда нельзя: с immutable браузер больше НИКОГДА не перезапросит файл, и вернувшийся посетитель останется со старой версией сайта. must-revalidate заставляет проверять актуальность — при совпадении приходит пустой 304, это быстро.",
      "source": "/(.*)\\.(css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "//": "Ответы функций не кешируем никогда — это живые данные чата.",
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
