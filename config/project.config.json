{
  "$schema": "./project.config.schema.json",
  "brand": {
    "name": "15minYoga",
    "legalName": "15minYoga — yoga for decision makers",
    "tagline": {
      "ru": "Йога для тех, кто принимает решения",
      "en": "Yoga for those who make decisions",
      "de": "Yoga für alle, die Entscheidungen treffen",
      "uk": "Йога для тих, хто ухвалює рішення"
    },
    "domainPrimary": "15minyoga.com",
    "domainFallbacks": [
      "15minyoga.com"
    ],
    "defaultLocale": "ru",
    "locales": [
      "ru",
      "en",
      "de",
      "uk"
    ]
  },
  "schedule": {
    "timezone": "Europe/Vienna",
    "daily": {
      "days": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri"
      ],
      "start": "07:00",
      "end": "07:15",
      "durationMin": 15
    },
    "weeklyDeep": {
      "day": "sat",
      "start": "08:00",
      "end": "09:00",
      "durationMin": 60
    },
    "reminderOffsetsMin": [
      60,
      10
    ],
    "streamPlatform": "zoom",
    "streamLinkEnv": "STREAM_LINK"
  },
  "pricing": {
    "currency": "EUR",
    "plans": [
      {
        "id": "m1",
        "label": {
          "ru": "1 месяц",
          "en": "1 month",
          "de": "1 Monat",
          "uk": "1 місяць"
        },
        "months": 1,
        "price": 100
      },
      {
        "id": "m6",
        "label": {
          "ru": "6 месяцев",
          "en": "6 months",
          "de": "6 Monate",
          "uk": "6 місяців"
        },
        "months": 6,
        "price": 500
      },
      {
        "id": "m12",
        "label": {
          "ru": "12 месяцев",
          "en": "12 months",
          "de": "12 Monate",
          "uk": "12 місяців"
        },
        "months": 12,
        "price": 900
      }
    ],
    "trial": {
      "enabled": true,
      "days": 3,
      "note": "Первое занятие — бесплатный пробный доступ через бота."
    }
  },
  "payments": {
    "mode": "hybrid",
    "invoicedBy": "legal.operator",
    "methods": {
      "bankEUR": {
        "enabled": true,
        "currency": "EUR",
        "label": {
          "ru": "Перевод на счёт (EUR)",
          "en": "Bank transfer (EUR)",
          "de": "Überweisung (EUR)",
          "uk": "Переказ на рахунок (EUR)"
        },
        "comment": "Реквизиты выдаёт только бот в личке, на лендинге их нет.",
        "beneficiary": "REPLACE_ME",
        "ibanEnv": "EUR_IBAN",
        "bic": "REPLACE_ME",
        "bankName": "REPLACE_ME"
      },
      "paypal": {
        "enabled": true,
        "label": {
          "ru": "PayPal",
          "en": "PayPal",
          "de": "PayPal",
          "uk": "PayPal"
        },
        "comment": "PayPal Фильянова — уточнить, на какое лицо оформлен аккаунт.",
        "meLinkEnv": "PAYPAL_ME",
        "meLink": "REPLACE_ME"
      },
      "liqpay": {
        "enabled": true,
        "currency": "UAH",
        "label": {
          "ru": "LiqPay (грн)",
          "en": "LiqPay (UAH)",
          "de": "LiqPay (UAH)",
          "uk": "LiqPay (грн)"
        },
        "comment": "ФОП Фільянов П.О. Ссылка/кнопка LiqPay — из кабинета LiqPay.",
        "linkEnv": "LIQPAY_LINK",
        "link": "REPLACE_ME"
      },
      "crypto": {
        "enabled": true,
        "label": {
          "ru": "Криптовалюта",
          "en": "Crypto",
          "de": "Krypto",
          "uk": "Криптовалюта"
        },
        "comment": "Кошелёк выдаёт бот. Сеть и адрес уточнить (рекомендуется USDT TRC-20).",
        "network": "REPLACE_ME",
        "addressEnv": "CRYPTO_WALLET",
        "address": "REPLACE_ME"
      }
    },
    "removed": "Monobank-банка заменена на LiqPay по решению владельца."
  },
