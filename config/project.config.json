{
  "$schema": "./project.config.schema.json",
  "brand": {
    "name": "Niguma",
    "legalName": "Niguma — yoga for decision makers",
    "tagline": {
      "ru": "Йога для тех, кто принимает решения",
      "en": "Yoga for those who make decisions",
      "de": "Yoga für alle, die Entscheidungen treffen",
      "uk": "Йога для тих, хто ухвалює рішення"
    },
    "domainPrimary": "niguma.yoga",
    "domainFallbacks": ["niguma.com", "niguma.online"],
    "defaultLocale": "ru",
    "locales": ["ru", "en", "de", "uk"]
  },

  "schedule": {
    "timezone": "Europe/Berlin",
    "daily": { "days": ["mon", "tue", "wed", "thu", "fri"], "start": "07:00", "end": "07:15", "durationMin": 15 },
    "weeklyDeep": { "day": "sat", "start": "08:00", "end": "09:00", "durationMin": 60 },
    "reminderOffsetsMin": [60, 10],
    "streamPlatform": "zoom",
    "streamLinkEnv": "STREAM_LINK"
  },

  "pricing": {
    "currency": "EUR",
    "plans": [
      { "id": "m1",  "label": { "ru": "1 месяц",   "en": "1 month",   "de": "1 Monat",   "uk": "1 місяць" },  "months": 1,  "price": 100 },
      { "id": "m6",  "label": { "ru": "6 месяцев", "en": "6 months",  "de": "6 Monate",  "uk": "6 місяців" }, "months": 6,  "price": 500 },
      { "id": "m12", "label": { "ru": "12 месяцев","en": "12 months", "de": "12 Monate", "uk": "12 місяців" },"months": 12, "price": 900 }
    ],
    "trial": { "enabled": true, "days": 3, "note": "Первое занятие — бесплатный пробный доступ через бота." }
  },

  "payments": {
    "mode": "hybrid",
    "automated": {
      "stripe": {
        "enabled": false,
        "comment": "Включить после верификации Stripe-аккаунта (Германия). Положить ссылки Payment Links / Pricing Table.",
        "paymentLinks": { "m1": "", "m6": "", "m12": "" },
        "publishableKeyEnv": "STRIPE_PUBLISHABLE_KEY"
      },
      "paypal": {
        "enabled": true,
        "comment": "Самый быстрый способ принимать карты мира. Подписки или разовые ссылки.",
        "meLink": "https://www.paypal.me/REPLACE_ME",
        "subscriptionLinks": { "m1": "", "m6": "", "m12": "" }
      }
    },
    "manual": {
      "eurIban": {
        "enabled": true,
        "comment": "Реквизиты НЕ публикуем на лендинге — выдаёт только бот после запроса.",
        "beneficiary": "REPLACE_ME",
        "ibanEnv": "EUR_IBAN",
        "bic": "REPLACE_ME",
        "bankName": "REPLACE_ME"
      },
      "monobank": {
        "enabled": true,
        "currency": "UAH",
        "comment": "Ссылка-банка Monobank (jar) или номер карты. Выдаёт бот.",
        "jarLink": "https://send.monobank.ua/jar/REPLACE_ME",
        "cardEnv": "MONOBANK_CARD"
      }
    },
    "recommendedToAdd": ["Wise (мультивалютный приём EUR/USD/GBP)", "Revolut Business", "Lemon Squeezy / Paddle (Merchant of Record — берёт на себя НДС по миру)"]
  },

  "social": {
    "instagram": { "handle": "niguma.yoga", "url": "https://instagram.com/niguma.yoga", "isPrimarySupport": true },
    "facebook": { "url": "https://facebook.com/niguma.yoga" },
    "telegram": {
      "channelUrl": "https://t.me/niguma_yoga",
      "botUsername": "niguma_bot",
      "botUrl": "https://t.me/niguma_bot",
      "botDeepLinkParam": "src",
      "isPrimaryComms": true
    },
    "email": { "address": "hello@niguma.yoga", "comment": "Завести после регистрации домена; до этого — пусто/скрыто." },
    "youtube": { "url": "" }
  },

  "support": {
    "primaryChannel": "instagram",
    "instagramDM": "https://ig.me/m/niguma.yoga",
    "botFirstClient": "https://t.me/niguma_bot?start=lead_landing",
    "escalationToAuthor": "https://ig.me/m/niguma.yoga"
  },

  "funnel": {
    "leadMagnet": "Бесплатное пробное утреннее занятие + 1 видео о философии Нигумы",
    "nurtureSequenceDays": [0, 1, 3, 5, 7, 10, 14],
    "cohortStartDay": "mon",
    "minimalData": ["telegram_id", "locale"],
    "optionalData": ["email", "name"],
    "doubleOptIn": true
  },

  "gamification": {
    "enabled": true,
    "comment": "Подробности генерируются в docs/GAMIFICATION.md и bot/services/gamification.py"
  }
}
